;; -*- mode: lisp-data; -*-
;; Tempel templates.  Insert with M-+ (complete name at point), M-* (pick
;; from a list), or type the name after `<' and complete.  Elements:
;; strings are inserted; (p "prompt") is a field; (s name) repeats a field;
;; n is newline, n> newline-and-indent, q ends the template with point there.
;; A mode section applies to that mode and modes derived from it.

fundamental-mode

(today (format-time-string "%Y-%m-%d"))
(now   (format-time-string "%Y-%m-%d %H:%M"))

prog-mode

(todo comment-start "TODO(" (p "nana") "): " q)
(fixme comment-start "FIXME: " q)
(note comment-start "NOTE: " q)

emacs-lisp-mode lisp-interaction-mode

(lambda "(lambda (" p ")" n> r> ")")
(fun "(defun " p " (" p ")" n> "\"" p "\"" n> r> ")")
(var "(defvar " p " " p n> "\"" p "\")")
(let "(let (" p ")" n> r> ")")
(let* "(let* (" p ")" n> r> ")")
(when "(when " p n> r> ")")
(unless "(unless " p n> r> ")")
(pkg "(use-package " p n> ":ensure nil" n> ":custom" n> ":config" n> r> ")")
(hook "(add-hook '" p "-hook #'" p ")")

tuareg-mode

(let "let " (p "name") " " (p "args") " =" n> r> q)
(letin "let " (p "name") " = " (p "expr") " in" n> r>)
(letrec "let rec " (p "name") " " (p "args") " =" n> r> q)
(fun "fun " (p "x") " -> " q)
(match "match " (p "expr") " with" n> "| " (p "pattern") " -> " q)
(mod "module " (p "Name") " = struct" n> r> n "end")
(sig "module type " (p "NAME") " = sig" n> r> n "end")
(functor "module " (p "Make") " (" (p "M") " : " (p "S") ") = struct" n> r> n "end")
(type "type " (p "t") " =" n> "| " (p "Constructor") q)
(rec "type " (p "t") " = {" n> (p "field") " : " (p "type") ";" n "}")
(ifthen "if " (p "cond") " then " (p "a") " else " q)
(begin "begin" n> r> n "end")
(printf "Printf.printf \"" (p "%s\\n") "\" " q)
(test "let () =" n> "assert (" p ")" q)

haskell-mode

(mod "module " (p "Main") " where" n n r>)
(imp "import " (p "Data.List") q)
(impq "import qualified " (p "Data.Map") " as " (p "M") q)
(fn (p "name" name) " :: " (p "a -> b") n (s name) " " (p "x") " = " q)
(data "data " (p "T" name) " = " (s name) n> "deriving (" (p "Show, Eq") ")")
(newtype "newtype " (p "T" name) " = " (s name) " { un" (s name) " :: " (p "a") " }")
(inst "instance " (p "Class") " " (p "T") " where" n> r>)
(class "class " (p "C") " " (p "a") " where" n> r>)
(case "case " (p "expr") " of" n> (p "pattern") " -> " q)
(let "let " (p "x") " = " (p "expr") n> "in " q)
(where "where" n> r>)
(lam "\\" (p "x") " -> " q)
(main "main :: IO ()" n "main = do" n> r>)
(pragma "{-# LANGUAGE " (p "OverloadedStrings") " #-}" q)

racket-mode scheme-mode

(lang "#lang racket" n n r>)
(def "(define (" (p "name") " " (p "args") ")" n> r> ")")
(defv "(define " (p "name") " " (p "value") ")")
(lam "(lambda (" (p "x") ") " r> ")")
(let "(let ([" (p "x") " " (p "v") "])" n> r> ")")
(let* "(let* ([" (p "x") " " (p "v") "])" n> r> ")")
(cond "(cond" n> "[" (p "test") " " (p "expr") "]" n> "[else " q "])")
(match "(match " (p "expr") n> "[" (p "pattern") " " q "])")
(struct "(struct " (p "name") " (" (p "fields") ") #:transparent)")
(req "(require " (p "racket/list") ")")
(prov "(provide " (p "name") ")")
(test "(module+ test" n> "(require rackunit)" n> "(check-equal? " p " " p "))")
(for "(for ([" (p "x") " " (p "xs") "])" n> r> ")")

sml-mode

(fn "fun " (p "name") " " (p "args") " =" n> r> q)
(val "val " (p "name") " = " q)
(let "let" n> "val " (p "x") " = " (p "expr") n "in" n> r> n "end")
(case "case " (p "expr") " of" n> (p "pattern") " => " q)
(datatype "datatype " (p "t") " = " (p "A") " | " (p "B") q)
(sig "signature " (p "NAME") " =" n "sig" n> r> n "end")
(struct "structure " (p "Name") " =" n "struct" n> r> n "end")
(fun "fn " (p "x") " => " q)

python-base-mode

(def "def " (p "name") "(" (p "args") ")" (p " -> None") ":" n> r> "..." q)
(adef "async def " (p "name") "(" (p "args") "):" n> r> q)
(class "class " (p "Name") (p "(Base)") ":" n> "def __init__(self" (p ", args") "):" n> r> q)
(dc "@dataclass" n "class " (p "Name") ":" n> (p "field") ": " (p "type") q)
(main "def main() -> None:" n> r> n n "if __name__ == \"__main__\":" n> "main()")
(ifmain "if __name__ == \"__main__\":" n> r> "main()")
(try "try:" n> r> n "except " (p "Exception") " as e:" n> q)
(with "with " (p "expr") " as " (p "name") ":" n> r>)
(for "for " (p "x") " in " (p "xs") ":" n> r>)
(imp "import " q)
(from "from " (p "module") " import " q)
(np "import numpy as np")
(pd "import pandas as pd")
(plt "import matplotlib.pyplot as plt")
(torch "import torch" n "import torch.nn as nn" n "import torch.nn.functional as F")
(cell "# %%" n r>)
(test "def test_" (p "name") "():" n> r> "assert " q)
(bp "breakpoint()")
(log "import logging" n "logger = logging.getLogger(__name__)")

c-ts-mode c++-ts-mode c-mode c++-mode

(main "int main(int argc, char **argv) {" n> r> n> "return 0;" n "}")
(inc "#include <" (p "stdio.h") ">")
(incl "#include \"" (p "header.h") "\"")
(guard "#ifndef " (p "HEADER_H" g) n "#define " (s g) n n r> n n "#endif /* " (s g) " */")
(fn (p "int") " " (p "name") "(" (p "void") ") {" n> r> n "}")
(struct "struct " (p "name") " {" n> r> n "};")
(for "for (" (p "size_t i = 0") "; " (p "i < n") "; " (p "i++") ") {" n> r> n "}")
(while "while (" (p "cond") ") {" n> r> n "}")
(if "if (" (p "cond") ") {" n> r> n "}")
(printf "printf(\"" (p "%s\\n") "\", " q ");")
(assert "assert(" p ");")

rust-ts-mode

(fn "fn " (p "name") "(" (p "args") ")" (p " -> T") " {" n> r> n "}")
(main "fn main() {" n> r> n "}")
(struct "#[derive(Debug)]" n "struct " (p "Name") " {" n> (p "field") ": " (p "T") "," n "}")
(enum "#[derive(Debug)]" n "enum " (p "Name") " {" n> (p "Variant") "," n "}")
(impl "impl " (p "Type") " {" n> r> n "}")
(match "match " (p "expr") " {" n> (p "pattern") " => " q "," n "}")
(test "#[cfg(test)]" n "mod tests {" n> "use super::*;" n n> "#[test]" n> "fn " (p "name") "() {" n> r> n> "}" n "}")
(iflet "if let " (p "Some(x)") " = " (p "expr") " {" n> r> n "}")

org-mode

(title "#+title: " (p "Title") n "#+date: " (format-time-string "%Y-%m-%d") n "#+filetags: " q)
(src "#+begin_src " (p "emacs-lisp") n r> n "#+end_src")
(py "#+begin_src python :results output" n r> n "#+end_src")
(ml "#+begin_src ocaml" n r> n "#+end_src")
(hs "#+begin_src haskell" n r> n "#+end_src")
(sh "#+begin_src shell" n r> n "#+end_src")
(quote "#+begin_quote" n> r> n "#+end_quote")
(example "#+begin_example" n> r> n "#+end_example")
(todo "* TODO " (p "task") n ":PROPERTIES:" n ":CREATED: " (format-time-string "[%Y-%m-%d %a %H:%M]") n ":END:" q)
(link "[[" (p "url") "][" (p "description") "]]")
(math "\\(" r "\\)")
(dmath "\\[" n> r> n "\\]")

markdown-mode

(code "```" (p "python") n r> n "```")
(link "[" (p "text") "](" (p "url") ")")
(img "![" (p "alt") "](" (p "path") ")")
(front "---" n "title: " (p "Title") n "date: " (format-time-string "%Y-%m-%d") n "tags: [" (p "tag") "]" n "---" n q)
(table "| " (p "a") " | " (p "b") " |" n "|---|---|" n "| " q " |  |")
